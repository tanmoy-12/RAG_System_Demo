# Hosted model backend: groq or standin
LLM_BACKEND=groq
GROQ_API_KEY=put_your_key_here
# Confirm the model is enabled for your own account with: python -m relay_rag.check_groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local query rewriting (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=10

# Retrieval / embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_RETRIEVAL_SETTING=balanced
MIN_RETRIEVAL_SCORE=0.30
INDEX_DIR=data/indexes
PAPERS_DIR=data/papers

# Rate limiting. Set values from your own Groq console/account.
# Header semantics documented by Groq: x-ratelimit-limit-requests = RPD;
# x-ratelimit-limit-tokens = TPM. Do NOT use RPD as RPM.
GROQ_RPM=0
GROQ_TPM=0
GROQ_RPD=0
GROQ_TPD=0
MAX_OUTPUT_TOKENS=700
REQUEST_DEADLINE_SECONDS=50
MODEL_CALL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_MAX_WAIT_SECONDS=5

# Cost calculation is left blank unless you choose a price basis.
# Enter USD per 1M tokens for the selected model, or leave 0 for free-tier actual cost.
GROQ_INPUT_PRICE_PER_1M=0
GROQ_OUTPUT_PRICE_PER_1M=0

# API / logs
APP_HOST=127.0.0.1
APP_PORT=8000
RESULTS_CSV=results/results.csv
RUN_SOURCE=real
RUN_SCENARIO=manual

# Stand-in defaults. Change at runtime through /admin/config too.
STANDIN_BASE_LATENCY_MS=350
STANDIN_JITTER_MS=120
STANDIN_PER_EXTRA_INFLIGHT_MS=180
STANDIN_FAILURE_RATE=0.03
STANDIN_RPM_LIMIT=0
STANDIN_DAILY_LIMIT=0
STANDIN_MAX_INFLIGHT=0
